# Copy to .env.local to change how the frontend reaches its data.

# true: run on the in-memory mock (src/api/mockData.ts), no backend needed.
VITE_USE_MOCK=false

# Where the API lives in a production build. In `npm run dev`, /api is
# proxied to http://127.0.0.1:8000 by vite.config.ts.
# VITE_API_URL=/api
